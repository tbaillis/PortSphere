<Window x:Class="AISphere.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AISphere" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="ChatHistory" Grid.Row="0" Margin="10"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <TextBox x:Name="UserInput" Width="600" Margin="0,0,10,0"/>
            <Button Content="Send" Click="SendButton_Click"/>
            <Button Content="Manage Variables" Click="ManageVariablesButton_Click" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
